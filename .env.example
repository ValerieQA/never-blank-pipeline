# Never Blank Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to the repository.
# All variables use the NB_ prefix for project isolation.

# ── OpenAI (LLM provider for all AI tasks) ──────────────────────────────────
# Required for: observation discovery, content generation, QC checks, rewrites
# Required for: semantic embeddings (deduplication, relevance scoring)
NB_OPENAI_API_KEY=
NB_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NB_OPENAI_TEMPERATURE=0.7
NB_OPENAI_QC_TEMPERATURE=0.2

# ── Per-stage model configuration ────────────────────────────────────────────
# Each pipeline stage can use a different model for cost/quality balance.
# Falls back to NB_OPENAI_CHAT_MODEL, then gpt-4o if a stage var is unset.
#
# Recommended defaults (set these in GitHub Secrets or .env):
NB_DISCOVERY_MODEL=gpt-4.1-mini
NB_SCORING_MODEL=gpt-4.1-mini
NB_ENRICH_MODEL=gpt-4.1
NB_ARTICLE_MODEL=gpt-4.1
NB_SOCIAL_MODEL=gpt-4.1-mini
NB_IMAGE_MODEL=gpt-image-1
#
# Legacy fallback (only used if stage-specific vars above are not set):
NB_OPENAI_CHAT_MODEL=gpt-4o

# ── Cloudinary (image hosting) ───────────────────────────────────────────────
# Required for: storing and serving generated visual assets
NB_CLOUDINARY_CLOUD_NAME=
NB_CLOUDINARY_API_KEY=
NB_CLOUDINARY_API_SECRET=

# ── Publishing guards ────────────────────────────────────────────────────────
# NB_RESEARCH_PUBLISH_ENABLED: must be 'true' to run Stage 11 publishing (default: false)
# NB_RESEARCH_MAX_PUBLISH_SIGNALS_PER_RUN: max signals published per run (default: 1)
# NB_PUBLISH_MODE: 'live' publishes for real, 'dry_run' validates only (default: live)
NB_RESEARCH_PUBLISH_ENABLED=false
NB_RESEARCH_MAX_PUBLISH_SIGNALS_PER_RUN=1
NB_PUBLISH_MODE=live

# ── Wix ──────────────────────────────────────────────────────────────────────
# Required for: publishing blog articles to Wix Blog
# WIX_SITE_ID: found in Wix dashboard → Settings → General Info
# WIX_POST_OWNER_ID: Wix member GUID of the blog post owner (required by Wix Blog v3
#   API for 3rd-party apps — cannot be resolved dynamically via API key auth).
#   How to find: Wix dashboard → Members → your profile → copy ID from the URL (UUID format).
# WIX_BLOG_CATEGORY_ID: optional — Wix category UUID to tag blog posts
# WIX_BLOG_TAG_IDS: optional — comma-separated Wix tag UUIDs
NB_WIX_API_KEY=
NB_WIX_SITE_ID=
NB_WIX_POST_OWNER_ID=
NB_WIX_BLOG_CATEGORY_ID=
NB_WIX_BLOG_TAG_IDS=
# Published blog base URL (no trailing slash) — used to build post URLs from slug
# Example: https://www.neverblank.co
NB_WIX_SITE_BASE_URL=

# ── LinkedIn (via Zernio) ─────────────────────────────────────────────────────
# Required for: publishing posts to the "Never Blank" LinkedIn organization page
# We post through Zernio (zernio.com) instead of calling LinkedIn's API directly,
# because posting as an organization requires LinkedIn's Community Management API,
# which LinkedIn only grants to legally registered entities (LLC/Corp/501c) — we
# don't have one. Zernio already holds LinkedIn Partner approval; connecting the
# page is just an OAuth click in the Zernio dashboard, no LinkedIn app review needed.
# NB_ZERNIO_API_KEY: from zernio.com/dashboard → API Keys
# NB_ZERNIO_LINKEDIN_ACCOUNT_ID: from zernio.com/dashboard/connections → the
#   "Never Blank" LinkedIn connection → copy icon next to it
NB_ZERNIO_API_KEY=
NB_ZERNIO_LINKEDIN_ACCOUNT_ID=

# ── Meta (Facebook + Instagram) ──────────────────────────────────────────────
# Required for: publishing to Facebook Page and Instagram Business Account
# Get from: Meta for Developers → Graph API Explorer
NB_META_FB_PAGE_ID=
NB_META_FB_PAGE_TOKEN=
NB_META_IG_USER_ID=

# ── Threads ──────────────────────────────────────────────────────────────────
# Required for: publishing short posts to Threads
NB_THREADS_ACCESS_TOKEN=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Required for: publishing signal-feed posts to Telegram channel
# BOT_TOKEN: get from @BotFather on Telegram
# CHANNEL_ID: channel username (e.g. @neverblank) or numeric ID
NB_TELEGRAM_BOT_TOKEN=
NB_TELEGRAM_CHANNEL_ID=

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Required for: reading manual topic queue, writing dashboard (Published, Pipeline Log, Health)
# CREDENTIALS_JSON: path to service account JSON file OR the JSON content as a string
# SHEET_ID: found in the Google Sheet URL between /d/ and /edit
NB_GOOGLE_SHEETS_CREDENTIALS_JSON=
NB_GOOGLE_SHEET_ID=
