.env
# data/ contents are generated at runtime — ignore everything except folder markers
data/*
!data/drafts/
!data/images/
!data/memory/
data/drafts/*
!data/drafts/.gitkeep
data/images/*
!data/images/.gitkeep
data/memory/*
!data/memory/visual_registry.json
# logo is a tracked asset — must NOT be ignored
assets/fonts/
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store
