.env
# data/ contents are generated at runtime — ignore everything except folder markers
data/*
!data/drafts/
!data/images/
!data/memory/
!data/research/
!data/strategy/
data/drafts/*
!data/drafts/.gitkeep
data/images/*
!data/images/.gitkeep
data/memory/*
!data/memory/visual_registry.json
data/research/*
!data/research/.gitkeep
!data/research/signals_active.jsonl
# Audit record of the 2026-08-20 corporate-backlog archive (Issue #142)
!data/research/signals_archived_corporate_backlog.jsonl
!data/research/selected_signals.jsonl
!data/research/seen_index.json
!data/research/image_library.json
!data/research/published_signal_ids.txt
data/research/archive/*
!data/research/archive/.gitkeep
# The publication idempotency authority is committed evidence, not runtime
# scratch (NB-00a, invariant S3-I1): losing a marker could cause a double
# publication, so it must survive the runner that wrote it.
!data/editorial/
data/editorial/*
!data/editorial/publication_markers/
# The durable learning ledger is tier 2 (NB-01d, Step 3 §3.2): one RunSummary
# per run, public-safe by construction (§3.3), committed because the
# indicators it carries must outlive the 90-day run workspace.
!data/editorial/runs/
# PNG images are already on Cloudinary — do not store in Git
reports/content_packages/images/
# Canonical run workspaces (NB-01b, Step 3 §2.1) are tier 1: everything a run
# produced, kept as a 90-day Actions artifact and never committed. What must
# outlive that is written to the durable ledger instead.
reports/editorial_runs/
# logo and fonts are tracked assets — must NOT be ignored
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store
